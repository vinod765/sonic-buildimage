{%- endmacro -%}

{%- macro generate_pg_profils(port_names_active) -%}
{%- set ports = port_names_active.split(',') if port_names_active else [] -%}
    "BUFFER_PG": {
{% for port in ports %}
                "{{ port }}|3-4": {
                     "profile" : "ingress_lossless_profile"
                },
{% endfor %}
{% for port in ports %}
                "{{ port }}|0": {
                    "profile" : "ingress_lossy_profile"
                },
{% endfor %}
{% for port in ports %}
                "{{ port }}|1-2": {
                    "profile" : "ingress_lossy_profile"
                },
{% endfor %}
{% for port in ports %}
                "{{ port }}|5-7": {
                    "profile" : "ingress_lossy_profile"
                }{% if not loop.last %},{% endif %}

{% endfor %}
    },
{%- endmacro -%}

{%- macro generate_queue_buffers(port_names_active) -%}
{%- set ports = port_names_active.split(',') if port_names_active else [] -%}

    "BUFFER_QUEUE": {
{% for port in ports %}
        "{{ port }}|3-4": {
             "profile" : "egress_lossless_profile"
        },
{% endfor %}
{% for port in ports %}
        "{{ port }}|0-2": {
            "profile" : "egress_lossy_profile"
        },
{% endfor %}
{% for port in ports %}
        "{{ port }}|5-7": {
            "profile" : "egress_lossy_profile"
        }{% if not loop.last %},{% endif %}

{% endfor %}
    }
{%- endmacro -%}
